# ===== REQUIRED =====
# GitHub Secret name must be exactly: GOOGLE_API_KEY
GOOGLE_API_KEY=${{ secrets.GOOGLE_API_KEY }}

# ===== ONE MODEL (sab jagah yahi) =====
MY_MODEL=${{ vars.MY_MODEL }}
# Available models:
# MY_MODEL=gemini-flash-latest (recommended - auto-updates)
# MY_MODEL=gemini-3.6-flash (stable production)
# MY_MODEL=gemini-3.7-flash (latest)

BASE_URL=${{ vars.BASE_URL }}
JARVIS_TEMPERATURE=${{ vars.JARVIS_TEMPERATURE }}
JARVIS_MAX_ITER=${{ vars.JARVIS_MAX_ITER }}
JARVIS_VERBOSE=${{ vars.JARVIS_VERBOSE }}
